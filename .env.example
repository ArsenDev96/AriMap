# AriMap player backend (Supabase). Copy to .env.local and fill in your dev project's values;
# see docs/PLAYER-BACKEND.md. Placeholders only: never commit real keys.
# Leave all three unset and the game runs as before, without player features.

# Project URL (Project Settings > Data API). Public: it is built into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (Project Settings > API Keys, sb_publishable_...). Public by design: it can only
# sign a browser in anonymously; every player table and function is closed to it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret key (Project Settings > API Keys, sb_secret_...). SERVER ONLY: never prefix it NEXT_PUBLIC_,
# never paste it into client code, and set it in Vercel as a sensitive variable.
SUPABASE_SECRET_KEY=sb_secret_replace_me
