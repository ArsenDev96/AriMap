{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.22.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
